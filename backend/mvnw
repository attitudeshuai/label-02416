# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.2.0
# ----------------------------------------------------------------------------

# Determine the project base directory
if [ -z "$MAVEN_PROJECTBASEDIR" ]; then
  MAVEN_PROJECTBASEDIR=$(cd "$(dirname "$0")" && pwd)
  export MAVEN_PROJECTBASEDIR
fi

MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Read distribution URL from properties
if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  distributionUrl=$(grep "^distributionUrl=" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

if [ -z "$distributionUrl" ]; then
  echo "Error: Could not read distributionUrl from $MAVEN_WRAPPER_PROPERTIES"
  exit 1
fi

# Set up Maven home
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
WRAPPER_DIR="$MAVEN_USER_HOME/wrapper/dists"

# Extract Maven version from URL
mavenVersion=$(echo "$distributionUrl" | sed 's/.*apache-maven-\([0-9.]*\).*/\1/')
MAVEN_HOME="$WRAPPER_DIR/apache-maven-$mavenVersion"

# Download and extract if not present
if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven $mavenVersion..."
  mkdir -p "$WRAPPER_DIR"
  
  DOWNLOAD_FILE="$WRAPPER_DIR/apache-maven-$mavenVersion-bin.zip"
  
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$DOWNLOAD_FILE" "$distributionUrl"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$DOWNLOAD_FILE" "$distributionUrl"
  else
    echo "Error: Neither curl nor wget found. Cannot download Maven."
    exit 1
  fi
  
  if [ $? -ne 0 ]; then
    echo "Error: Failed to download Maven from $distributionUrl"
    rm -f "$DOWNLOAD_FILE"
    exit 1
  fi
  
  echo "Extracting Maven..."
  unzip -q -d "$WRAPPER_DIR" "$DOWNLOAD_FILE"
  rm -f "$DOWNLOAD_FILE"
  
  if [ ! -d "$MAVEN_HOME" ]; then
    echo "Error: Failed to extract Maven"
    exit 1
  fi
  
  chmod +x "$MAVEN_HOME/bin/mvn"
  echo "Maven $mavenVersion installed to $MAVEN_HOME"
fi

# Execute Maven
exec "$MAVEN_HOME/bin/mvn" "$@"
