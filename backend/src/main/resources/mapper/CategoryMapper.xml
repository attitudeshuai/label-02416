<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.CategoryMapper">

    <select id="findAll" resultType="com.library.entity.Category">
        SELECT * FROM category ORDER BY sort ASC, id ASC
    </select>

    <select id="findById" resultType="com.library.entity.Category">
        SELECT * FROM category WHERE id = #{id}
    </select>

    <select id="findByName" resultType="com.library.entity.Category">
        SELECT * FROM category WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, description, sort) VALUES (#{name}, #{description}, #{sort})
    </insert>

    <update id="update">
        UPDATE category SET name = #{name}, description = #{description}, sort = #{sort} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM category WHERE id = #{id}
    </delete>

</mapper>
